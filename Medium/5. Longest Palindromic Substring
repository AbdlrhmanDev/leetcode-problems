class Solution(object):
    def longestPalindrome(self, s):
        start = 0
        max_len = 0

        for i in range(len(s)):

            # Odd palindrome
            left = i
            right = i

            while left >= 0 and right < len(s) and s[left] == s[right]:
                left -= 1
                right += 1

            length = right - left - 1

            if length > max_len:
                max_len = length
                start = left + 1

            # Even palindrome
            left = i
            right = i + 1

            while left >= 0 and right < len(s) and s[left] == s[right]:
                left -= 1
                right += 1

            length = right - left - 1

            if length > max_len:
                max_len = length
                start = left + 1

        return s[start:start + max_len]
